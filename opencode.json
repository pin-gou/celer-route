{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "lsp": true,
  "model": "pg-router/pg-expert",
  "plugin": ["list"],
  "agent": {
    "explore": {
      "model": "pg-router/pg-associate"
    },
    "build": {
      "model": "pg-router/pg-expert"
    },
    "plan": {
      "model": "pg-router/pg-expert"
    }
  },
  "provider": {
    "pg-test": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "test-router",
      "options": {
        "baseURL": "http://localhost:9080/v1"
      },
      "models": {
        "pg-test": {
          "name": "pg-test",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
