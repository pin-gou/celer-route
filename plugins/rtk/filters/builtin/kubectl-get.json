{
  "name": "kubectl-get",
  "command": "kubectl get",
  "rules": [
    {"type": "strip", "pattern": "^NAME\\s+READY\\s+STATUS"},
    {"type": "strip", "pattern": "^NAME\\s+STATUS\\s+ROLES"},
    {"type": "strip", "pattern": "\\s+Running\\s+\\d+"},
    {"type": "strip", "pattern": "\\s+Completed\\s+\\d+"}
  ],
  "head": 5,
  "tail": 3,
  "priority_patterns": ["CrashLoopBackOff", "ImagePullBackOff", "ErrImagePull", "Pending", "Terminating", "Evicted", "OOMKilled", "Init:Error", "CreateContainerConfigError", "Error", "Failed"],
  "tests": [{"name":"strips-header-and-steady-rows","input":"NAME   READY   STATUS    RESTARTS   AGE\nweb-1  1/1     Running   0          2d\nweb-2  1/1     Completed 0          3d\ndb-1   0/1     CrashLoopBackOff   3   1h","expected":"db-1   0/1     CrashLoopBackOff   3   1h"}]
}
